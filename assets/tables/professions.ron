        physical: 4,
        open_skills: [Sword, Axe, Polearm, MaceAndFlail, Dagger, StaffAndWand, Shield, ModernWeapon, Bow, ThrowingAndSling, CloseCombat, RangedCombat, DualWeapons, Artifacts, Mythology, Communication],
        traits: [StaminaRegeneration, Knockout, Berserk],
        starting_items: [143, 153, 203, 246],
        extra_item: ByTrainedSkill(skill: Axe, over: Sword, then: 18, otherwise: 7),
