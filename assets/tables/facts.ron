        "FACT_ALSEDEXUS_DISAPPEARS_RIFT": [Set([Scene("RemoveSedexusRift")])],
        "FACT_QUEST_KILL_ALSEDEXUS": [Set([Scene("Spacer")])],
        "FACT_ALETHEIDES_DISAPPEARS": [Always([Scene("AletheidesLeaves")])],
