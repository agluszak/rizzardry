        "FACT_LOCATION_GIGAS_OFFICERS_QUARTERS_GATE_OPEN1": [Set([
            Trigger("Door19"),
            Trigger("greenLightEwaxx"),
            Trigger("greenLightEwaxx01"),
            LevelVarOr("ObstacleDoors", 1),
        ])],
        "FACT_LOCATION_GIGAS_TOP_DOOR_OPEN1": [Set([Trigger("greenLightMeansOpen02"), Trigger("greenLightMeansOpen03")])],
        "FACT_LOCATION_GIGAS_TOP_DOOR_OPEN2": [Set([Trigger("greenLightMeansOpen02"), Trigger("greenLightMeansOpen03")])],
        "FACT_ARNIKA_HLL_OPEN": [Always([Trigger("scannerdoor"), TriggerOff("Scanner_Trigger_Plane")])],
        "FACT_MOOK_HALL_OPEN": [Always([Trigger("MookFrontDoor"), Trigger("Mookoff-01")])],
        "FACT_ARNIKA_BLACKBOX_RECEIVED": [Always([Trigger("blackboxrecorder")])],
        "FACT_ARNIKA_SAFETY_DEPOSIT_OPEN": [Always([Trigger("redbutton")])],
        "FACT_MURAL_OPEN": [
            Set([Trigger("MartenMural"), TriggerOff("Muraltrigger")]),
            Cleared([Trigger("Muraltrigger")]),
        ],
        "FACT_CM_RIDDLE2": [Always([TriggerOff("ChaosBTrigger"), Trigger("ChaosDoor01"), Scene("RemoveAletheidesAd")])],
        "FACT_DD_RIDDLE2": [Always([TriggerOff("KnowBTrigger"), Trigger("DoorKnow03"), Scene("RemoveAletheidesDd")])],
        "FACT_AD_RIDDLE2": [Always([TriggerOff("LifeBTrigger"), Trigger("DoorLife03"), Scene("RemoveAletheidesCm")])],
        "FACT_RAPAX_INITIATES": [Set([Mark(0x3c), Trigger("templargate07")])],
        "FACT_RAPAX_OPEN_TEMPLE": [Set([Mark(0x3a), Trigger("templargate10")])],
        "FACT_UMPANI_INITIATE_LANDING": [Set([
            LookAt(53550.0, 3516.0, 36936.0),
            If(Not(Is("FACT_TMISSION_KILL_UMPANI_CORD_SEVERED")), [Trigger("TR2ShipTrigger")]),
