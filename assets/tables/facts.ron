#![enable(implicit_some)]
// The story's facts that are not simply what was last set (retail
// `InitializeFactState`, `EvaluateFact`), by the fact's own name.
//
//   begins   the facts a new game begins with set
//   derived  the facts read off the world when asked:
//     Is(f)            as another fact is
//     Has(i)           the party holds item i
//     Held(of, at_least, at_most)
//                      how many of these items the party holds, each counted once
//     EveryoneHas(i)   every member holds item i
//     Friendly(f)      the faction is friendly
//     Joined(n)        person n is in the party, and awake
//     Companions(n)    exactly n people have joined the party
//     FitMember(r)     a member of race r is awake
//     Not, All, Any    of other readings
//     SetAnd(r)        what was last set, but only while r holds
//     Killed(n)        person n was killed
//     OwnAwake(n)      at least n of the party's own, companions aside, are awake
//     Chosen           the one Al-Sedexus chose is of the party
//     Stands(npc)      the person stands in the level
//     Units(i, n)      the party holds at least n of item i, counting each of a stack
//     Once(r)          as r reads until it is first seen to hold, then as last set
//     Level(n)         the party is in level n
//     LevelVar(v, n)   variable v of the party's level holds n
(
    begins: ["FACT_VIRGIN", "FACT_QUEST_VIRGIN_1", "FACT_QUEST_VIRGIN_2", "FACT_QUEST_VIRGIN_3"],
    derived: {
        // The three devices: Astral Dominae, Chaos Moliri, Destinae Dominus.
        "FACT_DEVICE_ONE": Held(of: [0x243, 0x242, 0x244], at_least: 1, at_most: 1),
        "FACT_DEVICE_TWO": Held(of: [0x243, 0x242, 0x244], at_least: 2, at_most: 2),
        "FACT_DEVICE_THREE": Held(of: [0x243, 0x242, 0x244], at_least: 3, at_most: 3),
        "FACT_RAPAX_AWAY_CAMP_EXISTS": Held(of: [0x243, 0x242, 0x244], at_least: 2, at_most: 3),

        "FACT_ARNIKA_PARTY_HAS_MARTEN_BADGE": Has(0x27b),
        "FACT_TRYNNIE_PC_HAS_HELM": Has(0x239),
        "FACT_QUEST_SHAMAN_GET_HELM": Not(Has(0x239)),
        "FACT_UMISSION_IUFPASS_LEVEL2": Has(0x268),
        "FACT_PARTY_HAS_BLOODLUST_SWORD": Has(0x294),
        "FACT_UMISSION_TRAIN_WETSUIT": EveryoneHas(0x1e5),
        "FACT_UMISSION_TRAIN_FIRE_NOAMMO": All([
            Not(Is("FACT_UMISSION_TRAIN_COVERT_ASSIGN")),
            Is("FACT_UMISSION_TRAIN_FIRE_ASSIGN"),
            Not(Has(0x271)),
            Not(Has(0x272)),
        ]),

        "FACT_FACTION_HIGARDI_BANK_FRIENDLY": Friendly(HigardiBank),
        "FACT_FACTION_HIGARDI_COMMON_FRIENDLY": Friendly(HigardiCommon),
        "FACT_FACTION_HIGARDI_HLL_FRIENDLY": Friendly(HigardiLunarLegion),
        "FACT_FACTION_HIGARDI_FELLOW_FRIENDLY": Friendly(Brotherhood),
        "FACT_FACTION_TRYNNIE_COMMON_FRIENDLY": Friendly(Trynnie),
        "FACT_FACTION_UMPANI_COMMON_FRIENDLY": Friendly(Umpani),
        "FACT_FACTION_TRANG_COMMON_FRIENDLY": Friendly(Trang),
        "FACT_FACTION_RAPAX_COMMON_FRIENDLY": Friendly(RapaxCommon),
        "FACT_FACTION_RAPAX_TEMPLAR_FRIENDLY": Friendly(RapaxTemplar),

        "FACT_MYLES_IN_PARTY": Joined(0x07),
        "FACT_PEACE_DRAZIC_IN_PARTY": Joined(0x10),
        "FACT_PEACE_RODAN_IN_PARTY": Joined(0x11),
        "FACT_VI_IN_PARTY": Joined(0x18),
        "FACT_TRYNNIE_SPARKLE_IN_PARTY": Joined(0x38),
        "FACT_TWO_IN_PARTY": Companions(2),
        "FACT_PEACE_TWO_IN_PARTY": SetAnd(All([Joined(0x11), Joined(0x10)])),
        "FACT_MOOK_MOOK_IN_PARTY": SetAnd(FitMember(Mook)),

        "FACT_ALIGNMENT_NONE": Not(Any([Is("FACT_ALIGNMENT_TRANG"), Is("FACT_ALIGNMENT_UMPANI")])),
        "FACT_RAPAX_SAVANT_ALLIANCE": Any([
            Is("FACT_ASTRAL_POSSESS"),
            Is("FACT_DESTINAE_POSSESS"),
            Is("FACT_CHAOS_POSSESS"),
        ]),
        "FACT_QUEST_SHAMAN_DESTINY_TWO": Not(All([
            Is("FACT_QUEST_MARTEN_DIARY"),
            Is("FACT_QUEST_MARTEN_IDOL"),
        ])),
        "FACT_QUEST_PEACE_UNLOCK_CAGES": Any([
            Is("FACT_RODAN_LOCKED_IN_CAGE"),
            Is("FACT_DRAZIC_LOCKED_IN_CAGE"),
        ]),
        "FACT_PARTY_DEACTIVATED_BOMB": Is("FACT_DS_BOMB_DEACTIVATED"),

        // Vi is counted dead as was last said, but never while she stands
        // awake in the party.
        // Five grenades once seen, and the member Al-Sedexus took, this
        // game does not have yet.
        "FACT_GLUMPH_DEAD": Killed(0x2b),
        // The five grenades of the covert training, once seen.
        "FACT_UMISSION_TRAIN_COVERT_DONE": Once(Units(0x1c4, 5)),
        "FACT_VI_IS_DEAD": SetAnd(Not(Joined(0x18))),
        "FACT_FATHER_IN_PARTY": Chosen,
    },
    // What setting a fact sets off (retail `HandleFactChange`): when it is
    // Set, when it is Cleared, or Always.
    //   Fact(f, v)             another fact is set to v
    //   If(reading, [..])      these, if the reading holds
    //   Faction(f, stance)     the faction becomes friendly or hostile
    //   FactionMet(f)          the faction is marked as met
    //   Group(species, stance) the first group of a species turns
    //   SkillFloor(skill, n)   each living member who may have the skill has at least n in it
    //   Raise(attribute, by, tells)
    //                          each member fit to act gains up to `by`, to 100 at most,
    //                          and the party is told string `tells`
    //   Returns                the member who was taken is back
    //   Trigger(name)          a named device of the level runs; TriggerOnce, if it never has
    //   TriggerOff(name)       a named device is switched off
    //   LevelVar(name, v)      a variable of the level is made; LevelVarOr sets bits in one
    //   Stock(npc, item, count, after)
    //                          a merchant gets items, `after` seconds from now
    //   Unstock(npc, item)     an item a merchant was to get is cancelled
    //   Mark(npc)              the person leaves where they stand, for good, once the party
    //                          has left the level
    //   Gone(npc)              the person's body leaves where it stood; GoneUnmet, if never greeted
    //   Stands(npc, level, at) the person stands at a named spot of another level
    //   Script(npc, script)    the person's body follows a script
    //   Renamed(npc)           the person goes by their other name: its lines and voice
    //   Restarts(quote)        the one spoken with says a quote, whatever they were saying
    //   MemberRemarks(npc, event)
    //                          the person, in the party, says something
    //   SpawnItem(item, at)    an item appears at a named spot
    //   SpawnMonster(species:, at:, stance:, faces:, script:)
    //                          one of a species appears at a named spot, facing another
    //                          and following a script if they are given
    //   PickMember             the player is to offer one of the party
    //   OthersFaint, OthersWake
    //                          everyone living but the chosen one lies senseless; wakes
    //   ChosenRemarks(event)   the chosen one says something
    //   AfterBattle(reading, [..])
    //                          these befall once a battle has been fought and is over,
    //                          and the reading holds
    //   Ends                   the game ends
    //   LeavesParty(npc)       the person is of the party no longer, and stands nowhere
    //   Greets(npc)            the person speaks to the party as they would on meeting it
    //   Offers(npc)            the person speaks to the party, handed what its hand holds
    //   LookAt(x, y, z)        the party looks at a point
    //   EndTalk                the conversation under way ends
    //   GroupScript(species, script)
    //                          the first group of a species follows a script
    //   GroupGone(species)     the leader of the first group of a species leaves the level
    //   SelfGone               the one spoken with leaves where they stood
    //   FirstGone([npc, ..])   the first of these people who stands in the level leaves it
    //   Moved(npc, at)         the person is at a named spot; GroupMoved, a group's leader
    //   Says(npc, quote)       the person speaks to the party, with a quote of theirs
    //   Unlock(name)           a named device's lock is overcome
    //   TriggerOn(name)        a named device is switched on and runs
    //   Shows(npc, cycle)      the person plays an animation; GroupShows, a group's leader
    //   ShowsThen(npc, cycle, [..]), GroupShowsThen(species, cycle, [..])
    //                          the same, and these befall the one who played it once it is
    //                          played out
    //   GroupDies(species)     the leader of the first group of a species dies
    //   GreetsOf(species)      the person whose species this is greets the party
    //   Later(seconds, [..])   these befall after so long
    //   Sound(file)            a sound, by its file under the game's sounds
    //   Shake(seconds, by)     the ground shakes
    //   Particle(name)         a named particle system of the level starts over
    //   CameraPath(name)       the party is flown along a named camera path
    //   Fade(dark, seconds, [..])
    //                          the screen dims to black, or comes back, and then these befall
    //   LookAtSpot(name)       the party looks at a named spot
    follows: {
