        "FACT_UMISSION_OBCOURSE_DONE": [Set([Mark(0x29)])],
        "FACT_UMISSION_IUFPASS_LEVEL4": [Set([Mark(0x29)])],
        "FACT_UMISSION_MOVE_RUBBLE_COVERT": [Set([Mark(0x29)])],
        "FACT_UMISSION_SCUBA_SOLVED_NO_ALIGN": [Set([Mark(0x2b)])],
        "FACT_RIFT_RAFE_FREE": [Set([Mark(0x44)])],
        "FACT_QUEEN_IS_FREE": [Set([Mark(0x56)])],
        "FACT_RATTUS_BANK_ROBBERY": [Set([Mark(0x52)])],
        "FACT_INTRO_VI_DISAPPEARS": [Set([Mark(0x18), EndTalk])],
        "FACT_KUNAR_IS_DEAD": [Always([Gone(0x2c)])],
        "FACT_PRINCE_NOT_IN_CASTLE": [Set([Gone(0x55), Scene("PrinceNotHome")])],
        "FACT_QUEST_SAVANT_BOMB_DEACTIVATED": [Always([GoneUnmet(0x57)])],
        "FACT_RAPAX_MYLES_IN_JAIL": [Set([If(Not(Joined(0x07)), [Stands(0x07, 0x11, "NP_MylesCell")])])],
        "FACT_MYLES_MISSION_RESCUE_VI_ASSIGNED": [Always([Script(0x07, "Guard.msf")])],
        "FACT_RFS81_HAS_BEEN_FIXED": [Set([Reload(0x20)])],

        "FACT_CROCK_KIDNAPPED_PLAYER": [Set([SpawnItem(0x2eb, "NP_BlueFlowers"), SpawnItem(0x2eb, "NP_BlueFlowers")])],
        "FACT_CROCK_BREKEK_ASSIGN": [Always([If(Not(Is("FACT_CROCK_BREKEK_DEAD")), [SpawnMonster(0x131, "Brekek")])])],

        "FACT_PEACE_SAVANT_BLOWUP_DONE": [Set([Scene("TriggerFix")])],
