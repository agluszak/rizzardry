            CameraPath("CameraPath4"),
            Fade(false, 1.0, [If(
                Any([Is("FACT_QUE_ENDGAME2"), All([Is("FACT_QUE_ENDGAME3"), Killed(0x87)])]),
                [Greets(0x8e)],
            )]),
        ])])],
        "FACT_ENDGAME_SAVANT_APPEARS": [Always([SpawnMonster(species: 0x234, at: "NP_DS1", stance: Neutral), Greets(0x84)])],
        "FACT_ENDGAME_SAVANT_PHOON_SPLIT": [Always([Shows(0x84, "SPECIAL"), GroupMoved(0x197, "NP_PHOONZANGLEE"), GroupShows(0x197, "ATTACK_SPECIAL"), Says(0x8d, 0x12)])],
        // Setting FACT_QUE_ENDGAME2 or FACT_QUE_ENDGAME3 only notes that it was
        // set, which the fact itself does; FACT_QUEST_KILL_ALSEDEXUS queues a
        // separator the original does nothing with.
        "FACT_ENDGAME_QUE_CONGRAT_TWO": [Always([Ends])],
        "FACT_ENDGAME_QUE_CONGRAT_THREE": [Always([Ends])],
        "FACT_ENDGAME_QUE_CONGRAT_FOUR": [Always([EndTalk,
            GroupScript(0xc2, "MoveSavantBoffo.msf"),
            Sound("misc/earthquake end.wav"),
            Shake(6.0, 1.0),
            Later(6.0, [Shake(3.0, 1.0), Ends]),
        ])],
    },
    // The named happenings a monster's script comes to with DOACTION
    // (retail `ProcessScript`), which befall the monster whose script it is:
    //   BodyGone           it leaves the level
    //   BodyScript(script) it follows another script
    //   BodyAsleep(rounds) it falls asleep
    //   BodyFacesParty     it turns to the party
    //   Engages(species)   the first group of a species joins battle
    happenings: {
        "STARTGOLEMATTACK": [Group(0x68, Hostile), Group(0x13e, Hostile), Engages(0x13e)],
        "ENDSAVANTWALK": [BodyGone, Trigger("Path3Trigger")],
        "ENDGARIWALK": [],
        "UNLOCKUI": [],
        "ENDHOGARWALK": [BodyScript("ClosePatrol.msf")],
        "ENDHOGARWALKANDPUTTOSLEEP": [BodyScript("ClosePatrol.msf"), BodyAsleep(6)],
        "ENDBELAWALK": [BodyGone],
        "BELA_END_CC_WALK": [Says(0x8d, 6), BodyFacesParty],
    },
    // What goes with a marked person's leaving (retail
    // `HandleMarkedNpcEvent`), by the person. Vi's leaving is forgotten.
    // Sergeant Rubble, in his own level, is first moved to his post and then
    // under the water, staying each time. Glumph leaves diving gear where he
    // stood unless the dive is done.
    //   RaceRemarks(race, event)
    //                      each member of a race who is awake says something
    //   Stays              the person does not leave after all
    //   Drops(npc, item, at)
    //                      an item is left where the person stands, or at a
    //                      named spot if they stand nowhere
    marked: {
        0x18: [Fact("FACT_INTRO_VI_DISAPPEARS", 0)],
        0x29: [
            If(All([Level(13), LevelVar("CODESgtRubbleTeleport", 0)]), [
                Moved(0x29, "RubbleCovert"),
                LevelVar("CODESgtRubbleTeleport", 1),
                Trigger("door08"),
                Fact("FACT_UMISSION_MOVE_RUBBLE_COVERT", 0),
                Stays,
            ]),
            If(All([Level(13), LevelVar("CODESgtRubbleTeleport", 1)]), [
                Moved(0x29, "rubbleUnderWater"),
                LevelVar("CODESgtRubbleTeleport", 2),
                Stays,
            ]),
        ],
        0x2b: [If(Not(Is("FACT_UMISSION_SCUBA_DONE")), [Drops(0x2b, 0x1e6, "NP_Glumph")])],
    },
    // The other name the story may give a person (retail
    // `GetNpcDisplayName`): RFS-81, once repaired.
    // The one Al-Sedexus is offered: a woman is refused while the party has anyone
    // else; one of the party's own who is fit and carries what she asks is chosen,
    // and is smitten with her once out of battle and away from her halls, unless
    // the person who spares them stands there.
    chosen: (
        clears: [
            "FACT_ALSEDEXUS_SACRIFICE_WOMAN",
            "FACT_ALSEDEXUS_SACRIFICE_ALL_WOMAN",
            "FACT_ALSEDEXUS_SACRIFICE_NOT_DRESSED",
            "FACT_ALSEDEXUS_SACRIFICE_NOT_ABLE",
        ],
        woman: "FACT_ALSEDEXUS_SACRIFICE_WOMAN",
        undressed: "FACT_ALSEDEXUS_SACRIFICE_NOT_DRESSED",
        unable: "FACT_ALSEDEXUS_SACRIFICE_NOT_ABLE",
        wears: [0x1fd, 0x1fe, 0x1ff],
        spared_by: 0x42,
        spared_in: ["levels/rapax/", "levels/rift/"],
        smitten: "FACT_QUEST_KILL_ALSEDEXUS",
    ),
    // How the game ends: the first of these whose reading holds.
    endings: [
        (Is("FACT_ENDGAME_JOIN_SAVANT"), Savant),
        (Is("FACT_QUE_ENDGAME2"), Cosmic),
        (Is("FACT_ENDGAME_SAVANT_PHOON_SPLIT"), Split),
        (Is("FACT_ENDING_BOFFO_ONE"), Blowout),
    ],
    renames: {
        0x20: "RFS81B",
    },    // What the death of one of a species sets off (retail `MonsterKilled`,
    // `HandleScriptedNpcDeath`): Brekek, the Rapax queen, the second of the
    // Rattkin breeders, Al-Sedexus, the king, the Lava Lord, and the Dark
    // Savant, at whose death the party speaks, the ending the party chose
    // goes on, and every hostile dies.
    //   FactionShift(f, by)    the faction's standing moves by so much
    //   ChosenFreed            the chosen one is smitten no longer
    //   AllRemark(event)       every member fit to speaks
    //   AnotherRemarks(but, event)
    //                          with more than two fit to, one other than the person speaks
    //   HostilesDie            every hostile monster of the level dies
    //   InHours(n, [..])       these befall after so many hours of the game's time
    slain: {
        0x131: [Fact("FACT_CROCK_BREKEK_DEAD", 1)],
        0x1a9: [Fact("FACT_QUEEN_IS_DEAD", 1), FactionShift(RapaxTemplar, 20)],
        0x14f: [
            If(Any([LevelVar("NumberRattkinBreedersKilled", 1), LevelVar("NumberRattkinBreedersKilled", 2)]), [
                LevelVar("NumberRattkinBreedersKilled", 2),
                Fact("FACT_TRYNNIE_KILL_RATS_DONE", 1),
                Faction(RattkinCommon, Hostile),
            ]),
            If(Not(Any([LevelVar("NumberRattkinBreedersKilled", 1), LevelVar("NumberRattkinBreedersKilled", 2)])), [
                LevelVar("NumberRattkinBreedersKilled", 1),
            ]),
        ],
        0xdd: [
            If(Any([LevelVar("NumberRattkinBreedersKilled", 1), LevelVar("NumberRattkinBreedersKilled", 2)]), [
                LevelVar("NumberRattkinBreedersKilled", 2),
                Fact("FACT_TRYNNIE_KILL_RATS_DONE", 1),
                Faction(RattkinCommon, Hostile),
            ]),
            If(Not(Any([LevelVar("NumberRattkinBreedersKilled", 1), LevelVar("NumberRattkinBreedersKilled", 2)])), [
                LevelVar("NumberRattkinBreedersKilled", 1),
            ]),
        ],
        0x22b: [
            If(Is("FACT_ALSEDEXUS_ATTACK"), [Fact("FACT_QUEST_KILL_ALSEDEXUS", 0)]),
            ChosenFreed,
            ChosenRemarks(37),
            Fact("FACT_RAPAX_ALSEDEXUS_DEAD", 1),
        ],
        0x181: [Fact("FACT_KING_IS_DEAD", 1)],
        0x175: [Fact("FACT_LAVALORD_DIE", 1)],
        0x222: [Fact("FACT_LAVALORD_DIE", 1)],
        0x234: [
            MemberRemarks(0x18, 24),
            AnotherRemarks(but: 0x18, event: 24),
            AllRemark(28),
            If(Any([Is("FACT_QUE_ENDGAME2"), All([Is("FACT_QUE_ENDGAME3"), Killed(0x87)])]), [
                Fade(true, 0.5, [
                    CameraPath("CameraPath4"),
                    Fade(false, 1.0, [Greets(0x8e)]),
                ]),
            ]),
            If(All([Is("FACT_QUE_ENDGAME3"), Not(Is("FACT_QUE_ENDGAME2")), Not(Killed(0x87))]), [Greets(0x87)]),
            HostilesDie,
        ],
    },
    // What the party's taking an item sets off (retail
    // `UpdateFactsAfterAcquiringItem`): the three devices and the false one are
    // possessed and their quests done; two days after the Chaos Moliri is first
    // taken the Mook know it stolen (the original counts the two days anew each
    // time it is taken up again).
    taken: {
        0x243: [
            If(Not(Is("FACT_DESTINAE_POSSESS")), [Fact("FACT_DESTINAE_POSSESS", 1)]),
            If(Is("FACT_QUEST_GET_DD"), [Fact("FACT_QUEST_GET_DD", 0)]),
        ],
        0x242: [
            If(Not(Is("FACT_ASTRAL_POSSESS")), [Fact("FACT_ASTRAL_POSSESS", 1)]),
            If(Is("FACT_QUEST_GET_AD"), [Fact("FACT_QUEST_GET_AD", 0)]),
        ],
        0x244: [
            If(Not(Is("FACT_CHAOS_POSSESS")), [
                Fact("FACT_CHAOS_POSSESS", 1),
                InHours(48, [Fact("FACT_MOOK_CHAOS_STOLEN", 1)]),
            ]),
            If(Is("FACT_QUEST_GET_CM"), [Fact("FACT_QUEST_GET_CM", 0)]),
        ],
        0x264: [
            If(Not(Is("FACT_ASTRAL_FAKE_POSSESS")), [
                Fact("FACT_ASTRAL_FAKE_POSSESS", 1),
                Fact("FACT_ASTRAL_FAKE_POSSESS1", 1),
            ]),
        ],
        0x201: [If(Is("FACT_QUEST_BRAFFIT_CIERDAN"), [Fact("FACT_QUEST_BRAFFIT_CIERDAN", 0)])],
        0x27c: [If(Is("FACT_QUEST_MYLES_FIND_DIAMOND"), [Fact("FACT_QUEST_MYLES_FIND_DIAMOND", 0)])],
        0x1d2: [If(Is("FACT_QUEST_MYLES_WEAPONS_CACHE"), [Fact("FACT_QUEST_MYLES_WEAPONS_CACHE", 0)])],
    },
)
