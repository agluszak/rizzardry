#![enable(implicit_some)]
// What each spell does to each body it lands on, in order; the spells are
// named as `SpellId` names them, in the order of their numbers.
//
// A row lists only what is not the default: it lands on `Everyone`, rolls
// nothing, always happens, allows no save and is not resisted.
//   kind         what it does (default: Harm)
//   on           Everyone | Members | Monsters | Party (the party as a whole)
//   roll         how its magnitude is rolled
//   chance       the percent chance it happens at all
//   save         the base of the save the body may make against it
//   spell_realm  the body resists it, and saves, in the spell's own realm
//   half         saved against and resisted at half strength, and lasting half
//                as long (retail `InflictConditionAttack`, `Magic Effects.cpp:1923-1928`)
//   landed       only if the row before it landed
//   resisted     only if the row before it was resisted
//   kinds        only these kinds of monster
// Spell... kinds and rolls take what they name from the spell's own record:
// SpellDice its dice, SpellRounds its duration, SpellEnchant itself.
// leeches: the damage it deals comes back to its caster's side, as Health
// or as (spell) Points.
// outlasts: the conditions an auto-powered cast must outlast, choosing the
// cheapest power that lifts the longest of them (retail
// `ChoosePowerLevelForDuration`).
// restores: what an auto-powered restoring spell measures its victim's lack
// in, Health, Stamina, or HealthThenStamina (retail `ChoosePowerLevelToRestore`).
// watches_stamina: an auto recast goes on while a victim is short of stamina
// rather than of health.
// absorbs: laid, it takes damage in the bearer's place, rolled as it is laid.
// answers_slowing: laid, it first spends itself against a slowing.
// bursts_into: each victim it killed bursts into this spell where it fell.
// turns_back: laid, it turns back what is aimed at enemies and lands on its
// bearer.
// buffs_elemental: Power Cast may lay it on an elemental summoned of this
// element (retail `ApplySummonElementalEffect`).
// backfire: what a spell turned on its caster does, in the same rows, for a
// personal spell (one without it does nothing) or a friendly one that can
// backfire (retail `CanSpellBackfire`); a hostile spell's is its ordinary
// effect.
// pulse: what a spell laid that pulses (spells_laid.ron) does to each body
// it strikes as a round ends, in the same rows (retail `TickCombatEffectSlots`
// for the clouds): Death Cloud makes a death save; the others hurt, Draining
// Cloud then draining spell points and stamina by its own roll, Toxic Cloud
// then nauseating, poisoning and knocking out.
{
    ACID_SPLASH: (
        effects: [
            (roll: SpellDice, spell_realm: true),
        ],
    ),
    BLESS: (
        effects: [
            (kind: SpellEnchant, on: Monsters, roll: SpellRounds),
            (kind: SpellEnchant, on: Party, roll: SpellRounds),
        ],
    ),
    FROST: (
        effects: [
            (roll: SpellDice, spell_realm: true),
        ],
    ),
    ENERGY_BLAST: (
        effects: [
            (roll: SpellDice, spell_realm: true),
        ],
    ),
    HEAL_WOUNDS: (
        restores: Health,
        effects: [
            (kind: Heal, roll: SpellDice),
        ],
    ),
    ITCHING_SKIN: (
        effects: [
            (kind: Afflict(condition: Irritated), roll: SpellRounds, save: 3, spell_realm: true),
        ],
    ),
    LIGHT: (
        effects: [
            (kind: SpellEnchant, on: Monsters, roll: SpellRounds),
            (kind: SpellEnchant, on: Party, roll: SpellRounds),
        ],
    ),
    MAKE_WOUNDS: (
        effects: [
            (roll: SpellDice, spell_realm: true),
        ],
    ),
    MIND_STAB: (
        effects: [
            (roll: SpellDice, spell_realm: true),
            (kind: Afflict(condition: Insane), roll: SpellRounds, chance: 25, save: 10, spell_realm: true),
        ],
    ),
