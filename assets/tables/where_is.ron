        (7, ["Sea Caves"]),
        (8, ["Bayjin"]),
        (9, ["Rapax Castle"]),
        (10, ["Rapax Rift"]),
        (11, ["Mt. Gigas", "Mt Gigas", "Gigas"]),
        (12, ["Ascension Peak"]),
        (13, ["Rapax Away Camp"]),
        (14, ["Cosmic Circle"]),
    ],
    directions: [
        [None, 117, 210, 210, 210, 210, 210, 213, 210, 211, 211, 211, 211, 213, 210, None, 210, 213],
        [None, 211, 117, 210, 210, 210, 210, 213, 210, 213, 213, 211, 211, 213, 210, None, 210, 213],
        [None, 211, 211, 117, 213, 213, 213, 213, 213, 213, 213, 211, 211, 213, 213, None, 212, 213],
        [None, 211, 212, 212, 117, 210, 213, 213, 211, 211, 211, 211, 211, 213, 211, None, 212, 211],
        [None, 211, 212, 212, 211, 117, 211, 213, 211, 211, 211, 211, 211, 213, 211, None, 212, 211],
        [None, 211, 212, 212, 212, 212, 117, 213, 212, 211, 211, 211, 211, 213, 212, None, 212, 211],
        [None, 213, 212, 212, 212, 212, 212, 117, 212, 211, 211, 211, 211, 213, 212, None, 212, 211],
