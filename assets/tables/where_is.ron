        [None, 212, 212, 210, 210, 210, 210, 210, 212, 117, 210, 212, 212, 210, 210, None, 212, 211],
        [None, 212, 212, 210, 210, 210, 210, 210, 210, 211, 117, 212, 212, 210, 210, None, 212, 211],
